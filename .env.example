# Generate independent random secrets: openssl rand -hex 32
#
# ---- Webhook mode (the default of this file): verify, filter and re-sign Forgejo issue events ----
FORGE_WEBHOOK_SECRET=replace-with-a-long-random-secret
OPENHANDS_WEBHOOK_SECRET=replace-with-another-long-random-secret
OPENHANDS_WEBHOOK_URL=https://openhands.example.com/v1/events/YOUR_ORG_ID/forgehands
ALLOWED_REPOS=team/example
PORT=8080
HOST=0.0.0.0
DATA_FILE=./data/deliveries.json

# ---- Direct mode: the whole loop from a labelled ticket to a merged pull request ----
# Setting OPENHANDS_API_URL switches to direct mode. To use it, comment out OPENHANDS_WEBHOOK_SECRET and OPENHANDS_WEBHOOK_URL above
# and uncomment what you need below. Values shown are the defaults unless the line says "example".
#
# Forge: forgejo (default), gitea or gitlab, with FORGE_URL, FORGE_TOKEN and FORGE_WEBHOOK_SECRET (the FORGEJO_* names were removed in 1.0.0).
# On GitLab 19.0 and later set FORGE_WEBHOOK_SECRET to the webhook's signing token (whsec_...): deliveries are then checked by HMAC.
# FORGE=forgejo
# FORGE_URL=https://git.example.com                    # example
# FORGE_TOKEN=replace-with-the-forgehands-users-token  # example: a user of its own, write access, no administrator
#
# OpenHands backend
# OPENHANDS_API_URL=http://openhands:8000              # example
# OPENHANDS_API_KEY=replace-with-the-backend-key       # example
# WORKSPACE_DIR=/projects
# Cleaning the workspace (README: Cleaning the workspace). Off until WORKSPACE_CLEANUP_DIR is set; the directory is the host directory of
# WORKSPACE_DIR, mounted into this container (for example /srv/docker/openhands/projects:/workspace in the compose file).
# WORKSPACE_CLEANUP_DIR=/workspace  # example: absolute, never /
# WORKSPACE_CLEANUP_DRY=0           # 1 = log what would be deleted, delete nothing (DRY_RUN=1 does the same)
# WORKSPACE_KEEP_HOURS=12           # a finished run keeps its clone this long after its end
# WORKSPACE_KEEP_FAILED_HOURS=72    # the same for a failed run
# WORKSPACE_ORPHAN_HOURS=48         # a clone that no ledger job names goes once its modification time is this old
# DISK_WARN_PERCENT=85              # one disk_full notification a day at this usage; 0 = off (needs WORKSPACE_CLEANUP_DIR)
# DISK_MIN_FREE_GB=3                # no new run below this many free gigabytes; 0 = off (needs WORKSPACE_CLEANUP_DIR)
#
# Routes: label to agent profile (UUID from GET /api/agent-profiles). "on" sets the kind of a route, see the README.   # example
# LABEL_ROUTES={"ai:plan": {"profile": "00000000-0000-0000-0000-000000000001", "tier": "strong", "max_iterations": 80, "max_budget": 1.5}, "ai:ready": {"profile": "00000000-0000-0000-0000-000000000002", "tier": "free"}, "ai:changes": {"profile": "00000000-0000-0000-0000-000000000002", "tier": "free", "on": "pull_request"}, "ai:fix": {"profile": "00000000-0000-0000-0000-000000000002", "tier": "free", "on": "ci_failure"}, "ai:review": {"profile": "00000000-0000-0000-0000-000000000003", "tier": "free", "on": "ci_success"}}
# Names of variables whose values every started conversation receives as secrets
# AGENT_SECRETS=FORGE_TOKEN,FORGE_URL
# Who may trigger runs and steer agents (comma separated logins); default: the sender of the label. Add reviewer users with native reviews.
# ALLOWED_SENDERS=maintainer                           # example
#
# Limits and scheduling
# MAX_CONCURRENT=4
# MAX_CONCURRENT_PER_TIER=2
# MAX_RUNS_PER_HOUR=30
# MAX_RUN_MINUTES=120
# REPO_WEIGHTS={"team/example": 1}
#
# Merge, review and rounds. A repository without a MERGE_POLICY entry is never merged by ForgeHands.
# MERGE_POLICY={"team/example": {"deny": ["infra/**"], "reasons": {"infra/**": "decides what is reachable from the internet"}}}   # example
# MERGE_METHOD=merge                # merge, squash, rebase, rebase-merge or fast-forward-only
# VERDICT_SOURCE=comment            # comment, review (native reviews: forgejo_token_secret on every review route) or both
# REQUIRED_APPROVALS=1              # more than 1 needs VERDICT_SOURCE=review or both
# MIN_REVIEW_CHARS=300
# APPROVED_LABEL=ai:approved
# BLOCKED_LABEL=ai:blocked
# APPROVAL_GRACE_SECONDS=90
# MAX_ROUNDS=3
# ESCALATE_FROM_ROUND=3             # default MAX_ROUNDS; has an effect with "escalate_to" on a round route
#
# Safety nets for merges without a human (README: Safety nets). All off or neutral until set.
# TWO_KEYS_HOLD_MINUTES=0           # a two-key merge waits this long (at most 1440) after both keys agreed; 0 = off
# SECURITY_REVIEWERS=security-bot    # example: logins whose security review counts; required when MERGE_POLICY has two_keys
# HOLD_LABEL=ai:hold                # this label on a pull request stops its two-key merge for as long as it is there
# TWO_KEYS_DAILY_LIMIT=0            # two-key merges per repository in 24 hours (at most 100); 0 = off
# REVERT_ON_RED=1                   # a red default branch after a merge of ForgeHands starts a revert when a main_red route exists; 0 = off
# REVERT_WINDOW_MINUTES=120         # how long after a merge a red default branch still counts (at most 10080)
# REVERT_RETRIES=1                  # after a merged revert the ticket is reopened and started again this many times, then blocked; 0 = off (at most 5)
# REVERT_RATE_ALERT=0              # percent of the merges of 30 days that were reverted; above it one failed notice a day per repository; 0 = off (0 to 100)
# RERUN_TIMEOUT_MINUTES=30            # a red default branch whose check was green before the merge: one rerun of its run, waited for this long; 0 = no rerun
# REVERT_RATE_MIN_MERGES=10        # the revert rate alert waits until this many merges are in the 30-day window
# EPIC_LABEL=ai:plan,ai:close
# EPIC_GAP_REPLAN=1              # an epic whose review finds it still open goes back to its planner this many times, then a human is called; 0 = the human at once (at most 5)
# EPIC_GAP_STALL_MINUTES=180      # how long an epic without new open sub-issues waits after its replan run before ForgeHands decides; 0 = off
#
# Keep agent pull requests current
# UPDATE_BRANCHES=1                 # 0 switches it off
# CHECKS_FROM_CI=1                  # 0: the forge's check result is not given to the reviewer, and a failed head may still get an OK verdict
# REVIEW_WITHOUT_CI=1               # 0: a repository without workflow files is not reviewed or merged without a green CI run
# WAIT_FOR_SAME_FILES=0             # 1: a ticket waits for older tickets that declare the same files (## Exact files)
# BRANCH_UPDATE_DELAY_SECONDS=60
# BRANCH_UPDATE_MIN_INTERVAL_MINUTES=30
#
# Dependency bot pull requests (Renovate)
# BOT_AUTHORS=renovate              # example
# BOT_REPOS=owner/repo             # example: only these allowed repositories have bot pull requests (default: all allowed)
# BOT_BRANCH_PREFIXES=renovate/     # example
# BOT_FIX_ROUNDS=0
#
# Humans, failures, housekeeping
# HUMAN_LOGIN=maintainer            # example: mentioned only where a human is needed
# REMIND_AFTER_DAYS=0               # 0 = off; needs FORGE_URL, FORGE_TOKEN and HUMAN_LOGIN
# REMIND_MAX=3
# Notifications of ForgeHands' own (README: Notifications). Off until a channel and NOTIFY_IMMEDIATE or NOTIFY_DIGEST are set.
# HUMAN_MENTION=1                   # 0 = comments without @HUMAN_LOGIN, so that the forge sends no mail
# COMMENT_RESTARTS=2                # a comment of HUMAN_LOGIN restarts a failed run of its issue, this many times per issue and label; 0 = off
# REVIEW_SWEEP_MINUTES=10           # starts the review of an open pull request head that has none in the ledger (lost or deferred events); 0 = off, at most 1440
# STUCK_PR_MINUTES=90             # the watchdog of the review sweep blocks an agent pull request with a NOT OK verdict and nothing running after this many minutes (rounds used up: at once); 0 = off, at most 10080
# TICKET_STALL_MINUTES=180        # the ticket watchdog of the review sweep starts an open ticket once more when its last run ended without a delivery this many minutes ago; the second time the human is called; 0 = off, at most 10080
# RECURRING_REASON_MIN=0          # the same NOT OK point in 14 days (one repository) files one ticket that asks for a check; 3 is a good start; 0 = off, at most 50
# PLAN_ANSWER_RESTARTS=5           # a comment of HUMAN_LOGIN answers a planner that finished without sub-issues, this many times per issue and label (max 20); 0 = off
# NOTIFY_IMMEDIATE=handover,blocked,failed   # kinds: handover, blocked, conflict, failed, reminder
# NOTIFY_DIGEST=08:00               # once a day, only when something is for the human
# NOTIFY_TIMEZONE=Europe/Berlin     # default UTC
# NOTIFY_LANGUAGE=en                # en or de
# SMTP_HOST=smtp.example.org        # SMTP_HOST, SMTP_FROM and SMTP_TO together
# SMTP_PORT=587
# SMTP_SECURITY=starttls            # starttls, tls or none
# SMTP_USER=forgehands@example.org
# SMTP_PASSWORD=replace-me
# SMTP_FROM=forgehands@example.org
# SMTP_TO=maintainer@example.org
# SMTP_TLS_VERIFY=1                 # 0 for a self-signed certificate (Proton Mail Bridge)
# SMTP_CA_FILE=/run/secrets/ca.pem
# NOTIFY_WEBHOOK_URL=https://ntfy.example/topic
# NOTIFY_WEBHOOK_AUTH=Bearer replace-me
# STALE_LABEL=ai:stale              # example, none by default
# ERROR_RETRIES=1
# RESUME_ATTEMPTS=1                 # a run that ends stuck or times out continues on its conversation this many times; 0 = off
# FAILURE_ESCALATE=1                # a round still stuck after that starts once more on its escalate_to profile; 0 = off
# PAUSE_RESUMES=3                   # a paused run continues on its conversation this many times (max 10); 0 = off, the human is called
# NUDGE_AT_PERCENT=65              # a worker run that used this share of its iteration limit without a pushed branch is told to push; 0 = off
# NUDGE_TIMEOUT_SECONDS=180         # how long a nudge may take to be answered (10 to 600)
# NUDGE_MESSAGE=                   # the text of that message instead of the default ({used}, {max}, {branch} are filled in)
# STALL_ALERT_MINUTES=90           # one stalled notification when work waits on a quota, the disk or a limit and nothing starts; 0 = off
# QUOTA_HOLD_MAX_HOURS=8
# QUOTA_GIVE_UP_HOURS=24
# SPLIT_LABEL=ai:plan               # example, none by default
# OPERATOR_LABEL=needs:operator     # a ticket that only an operator can do: no run starts on it, it waits for a human (README: Operator prerequisites)
# TICKET_PREFLIGHT=1               # 1 = a worker's ticket that breaks a blocking rule (TICKET_PREFLIGHT_BLOCK) starts no run (README); 0 = off
# TICKET_PREFLIGHT_BLOCK=2,3       # the rules whose findings reject a ticket: 1 to 4 as a comma list, or none; the other findings are advisory (prompt notes)
# ARCHIVE_AFTER_DAYS=7
# DELETE_AFTER_DAYS=0              # delete the OpenHands conversation of an archived run this many days after it ended (trajectory lost, ledger kept); 0 = off
# DELETE_FAILED_AFTER_DAYS=0       # failed runs keep their conversation this many days; 0 = same as DELETE_AFTER_DAYS, never lower than it
# LEDGER_SYNC_HOURS=6               # how often open tickets that the forge has closed are closed in the ledger (at most 60 reads a pass); 0 = off
# STATUS_HIDE_DAYS=7                # closed tickets older than this are left off the status page (?all=1 shows them); 0 = hide nothing
# JOBS_FILE=./data/jobs.json        # default: jobs.json next to DATA_FILE
#
# Status page, dashboard, status.json and /metrics: closed without a token. With one (16 characters or more) they need Authorization: Bearer <token>
# STATUS_TOKEN=replace-with-a-long-random-token        # example
# STATUS_PUBLIC=0                   # 1 opens them to everybody who can reach the port when no STATUS_TOKEN is set (not both)
#
# End-to-end suite (docs/e2e.md): scenarios against a dedicated test repository, never a real project. Off unless E2E_REPO is set.
# E2E_REPO=team/forgehands-e2e          # example: a test repository of ALLOWED_REPOS
# E2E_ON_START=0                        # 1: run the suite once after a start whose version has no e2e run in the ledger
# E2E_SCENARIOS=                        # comma list; empty: every non-experimental scenario
# E2E_TIMEOUT_MINUTES=90                # the time one scenario may take, cleanup not included
# E2E_QUEUE_MINUTES=60                  # how long a suite run may wait queued before the scenario fails (1 to 1440)
#
# Dry run: judge events as usual, only log every write. DRY_RUN_REPOS (each in ALLOWED_REPOS) limits it to some repositories.
# DRY_RUN=1
# DRY_RUN_REPOS=team/example                           # example
