# Generate independent random secrets: openssl rand -hex 32
#
# ---- Webhook mode (the default of this file): verify, filter and re-sign Forgejo issue events ----
FORGEJO_WEBHOOK_SECRET=replace-with-a-long-random-secret
OPENHANDS_WEBHOOK_SECRET=replace-with-another-long-random-secret
OPENHANDS_WEBHOOK_URL=https://openhands.example.com/v1/events/YOUR_ORG_ID/forgehands
ALLOWED_REPOS=team/example
PORT=8080
HOST=0.0.0.0
DATA_FILE=./data/deliveries.json

# ---- Direct mode: the whole loop from a labelled ticket to a merged pull request ----
# Setting OPENHANDS_API_URL switches to direct mode. To use it, comment out OPENHANDS_WEBHOOK_SECRET and OPENHANDS_WEBHOOK_URL above
# and uncomment what you need below. Values shown are the defaults unless the line says "example".
#
# Forge: forgejo (default), gitea or gitlab. FORGE_URL, FORGE_TOKEN and FORGE_WEBHOOK_SECRET are the neutral names of FORGEJO_URL,
# FORGEJO_TOKEN and FORGEJO_WEBHOOK_SECRET; set one name of a pair, not both with different values.
# FORGE=forgejo
# FORGE_URL=https://git.example.com                    # example
# FORGE_TOKEN=replace-with-the-forgehands-users-token  # example: a user of its own, write access, no administrator
#
# OpenHands backend
# OPENHANDS_API_URL=http://openhands:8000              # example
# OPENHANDS_API_KEY=replace-with-the-backend-key       # example
# WORKSPACE_DIR=/projects
#
# Routes: label to agent profile (UUID from GET /api/agent-profiles). "on" sets the kind of a route, see the README.   # example
# LABEL_ROUTES={"ai:plan": {"profile": "00000000-0000-0000-0000-000000000001", "tier": "strong", "max_iterations": 80, "max_budget": 1.5}, "ai:ready": {"profile": "00000000-0000-0000-0000-000000000002", "tier": "free"}, "ai:changes": {"profile": "00000000-0000-0000-0000-000000000002", "tier": "free", "on": "pull_request"}, "ai:fix": {"profile": "00000000-0000-0000-0000-000000000002", "tier": "free", "on": "ci_failure"}, "ai:review": {"profile": "00000000-0000-0000-0000-000000000003", "tier": "free", "on": "ci_success"}}
# Names of variables whose values every started conversation receives as secrets
# AGENT_SECRETS=FORGE_TOKEN,FORGE_URL
# Who may trigger runs and steer agents (comma separated logins); default: the sender of the label. Add reviewer users with native reviews.
# ALLOWED_SENDERS=maintainer                           # example
#
# Limits and scheduling
# MAX_CONCURRENT=4
# MAX_CONCURRENT_PER_TIER=2
# MAX_RUNS_PER_HOUR=30
# MAX_RUN_MINUTES=120
# REPO_WEIGHTS={"team/example": 1}
#
# Merge, review and rounds. A repository without a MERGE_POLICY entry is never merged by ForgeHands.
# MERGE_POLICY={"team/example": {"deny": ["infra/**"], "reasons": {"infra/**": "decides what is reachable from the internet"}}}   # example
# MERGE_METHOD=merge                # merge, squash, rebase, rebase-merge or fast-forward-only
# VERDICT_SOURCE=comment            # comment, review (native reviews: forgejo_token_secret on every review route) or both
# REQUIRED_APPROVALS=1              # more than 1 needs VERDICT_SOURCE=review or both
# MIN_REVIEW_CHARS=300
# APPROVED_LABEL=ai:approved
# BLOCKED_LABEL=ai:blocked
# APPROVAL_GRACE_SECONDS=90
# MAX_ROUNDS=3
# ESCALATE_FROM_ROUND=3             # default MAX_ROUNDS; has an effect with "escalate_to" on a round route
# EPIC_LABEL=ai:plan,ai:close
#
# Keep agent pull requests current
# UPDATE_BRANCHES=1                 # 0 switches it off
# BRANCH_UPDATE_DELAY_SECONDS=60
# BRANCH_UPDATE_MIN_INTERVAL_MINUTES=30
#
# Dependency bot pull requests (Renovate)
# BOT_AUTHORS=renovate              # example
# BOT_BRANCH_PREFIXES=renovate/     # example
# BOT_FIX_ROUNDS=0
#
# Humans, failures, housekeeping
# HUMAN_LOGIN=maintainer            # example: mentioned only where a human is needed
# REMIND_AFTER_DAYS=0               # 0 = off; needs FORGE_URL, FORGE_TOKEN and HUMAN_LOGIN
# REMIND_MAX=3
# STALE_LABEL=ai:stale              # example, none by default
# ERROR_RETRIES=1
# QUOTA_HOLD_MAX_HOURS=8
# QUOTA_GIVE_UP_HOURS=24
# SPLIT_LABEL=ai:plan               # example, none by default
# ARCHIVE_AFTER_DAYS=7
# JOBS_FILE=./data/jobs.json        # default: jobs.json next to DATA_FILE
#
# Status page, status.json and /metrics: with a token (16 characters or more) they need Authorization: Bearer <token>
# STATUS_TOKEN=replace-with-a-long-random-token        # example
#
# Dry run: judge events as usual, only log every write. DRY_RUN_REPOS (each in ALLOWED_REPOS) limits it to some repositories.
# DRY_RUN=1
# DRY_RUN_REPOS=team/example                           # example
